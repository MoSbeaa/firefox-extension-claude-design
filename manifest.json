{
  "manifest_version": 2,
  "name": "Claude Skin",
  "version": "1.0.0",
  "description": "Customise the look of claude.ai — background, fonts, sizes, colours, chat width and custom CSS.",
  "homepage_url": "https://github.com/MoSbeaa/firefox-extension-claude-design",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-skin@mosbeaa.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "*://claude.ai/*",
    "*://*.claude.ai/*",
    "*://claude.com/*",
    "*://*.claude.com/*"
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_action": {
    "default_title": "Claude Skin",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://claude.com/*",
        "*://*.claude.com/*"
      ],
      "js": ["common/settings.js", "content/apply.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
